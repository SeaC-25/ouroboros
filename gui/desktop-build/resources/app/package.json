{
  "name": "ouroboros-gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev-desktop.mjs",
    "build": "vite build && node scripts/build-desktop-main.mjs",
    "build:desktop-main": "node scripts/build-desktop-main.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:contract": "node scripts/check-gui-contract.mjs && node tests/catalog-action-launch.contract.test.mjs && node tests/agent-provider-run.contract.test.mjs && node tests/agent-profiles.contract.test.mjs && node tests/ai-action-agent-provider-run.contract.test.mjs && node tests/harness-agent-provider-task.contract.test.mjs && node tests/ai-action-orchestrator-results.contract.test.mjs && node tests/ai-actions-api.contract.test.mjs && node tests/backend-diagnostics.test.mjs && node tests/desktop-diagnostics.test.mjs && node tests/harness-prompt-workbench.contract.test.mjs && node tests/planning-field-labels.contract.test.mjs",
    "test:product-contract": "node scripts/check-product-contract.mjs",
    "test:desktop-contract": "node scripts/check-desktop-contract.mjs && node scripts/check-electron-runtime.mjs && node tests/dev-desktop.contract.test.mjs && node tests/install-desktop.contract.test.mjs",
    "package:desktop:prepare": "node scripts/package-desktop.mjs",
    "package:desktop:dry-run": "node scripts/package-desktop.mjs --dry-run",
    "package:desktop:dir": "node scripts/package-desktop.mjs --dir",
    "package:desktop:dir:dry-run": "node scripts/package-desktop.mjs --dir --dry-run",
    "package:desktop:install": "node scripts/install-desktop.mjs",
    "package:desktop:install:dry-run": "node scripts/install-desktop.mjs --dry-run",
    "smoke:desktop-package:runtime": "sh ../scripts/smoke_desktop_package_runtime.sh",
    "smoke:desktop-package:runtime:quick": "OURO_DESKTOP_PACKAGE_RUNTIME_SMOKE_MODE=quick sh ../scripts/smoke_desktop_package_runtime.sh",
    "smoke:desktop-package:runtime:diagnostics": "OURO_DESKTOP_PACKAGE_RUNTIME_SMOKE_MODE=diagnostics sh ../scripts/smoke_desktop_package_runtime.sh",
    "smoke:desktop-package:runtime:ai-lite": "OURO_DESKTOP_PACKAGE_RUNTIME_SMOKE_MODE=ai-lite sh ../scripts/smoke_desktop_package_runtime.sh",
    "electron": "node scripts/dev-desktop.mjs",
    "start": "node scripts/dev-desktop.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.3",
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "^2.2.0",
    "electron": "^33.4.11",
    "lucide-react": "^0.468.0",
    "postcss": "^8.5.16",
    "react": "^18.3.1",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^9.0.10",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.63.0"
  }
}
